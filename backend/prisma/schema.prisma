// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  MANAGER
  ACCOUNTANT
  CASHIER
  STAFF
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// A platform-level user. Can belong to multiple businesses via Membership.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

// A tenant. All business data is scoped to a businessId.
model Business {
  id                 String    @id @default(cuid())
  name               String
  gstin              String?
  pan                String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  logoUrl            String?
  financialYearStart DateTime?
  invoicePrefix      String    @default("INV")
  currency           String    @default("INR")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships     Membership[]
  customers       Customer[]
  suppliers       Supplier[]
  products        Product[]
  salesInvoices   SalesInvoice[]
  purchaseBills   PurchaseBill[]
  expenses        Expense[]
  salesReturns    SalesReturn[]
  purchaseReturns PurchaseReturn[]
  branches        Branch[]

  @@map("businesses")
}

model Branch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  purchaseBills PurchaseBill[]
  expenses      Expense[]

  @@index([businessId])
  @@map("branches")
}

// Links a User to a Business with a role — supports multi-business users.
model Membership {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("memberships")
}

model Customer {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  creditLimit    Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  salesReturns  SalesReturn[]

  @@index([businessId])
  @@map("customers")
}

model Supplier {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseBills   PurchaseBill[]
  purchaseReturns PurchaseReturn[]

  @@index([businessId])
  @@map("suppliers")
}

model Product {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  sku           String?
  barcode       String?
  category      String?
  unit          String   @default("PCS")
  hsnCode       String?
  purchasePrice Decimal  @default(0) @db.Decimal(14, 2)
  sellingPrice  Decimal  @default(0) @db.Decimal(14, 2)
  gstRate       Decimal  @default(0) @db.Decimal(5, 2)
  openingStock  Decimal  @default(0) @db.Decimal(14, 2)
  currentStock  Decimal  @default(0) @db.Decimal(14, 2)
  minStockLevel Decimal  @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoiceItems   SalesInvoiceItem[]
  purchaseBillItems   PurchaseBillItem[]
  salesReturnItems    SalesReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@index([businessId])
  @@map("products")
}

model SalesInvoice {
  id            String        @id @default(cuid())
  businessId    String
  branchId      String?
  customerId    String
  invoiceNumber String
  invoiceDate   DateTime      @default(now())
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  paymentMode   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id])
  customer Customer           @relation(fields: [customerId], references: [id])
  items    SalesInvoiceItem[]
  payments SalesPayment[]
  returns  SalesReturn[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([branchId])
  @@map("sales_invoices")
}

model SalesPayment {
  id             String   @id @default(cuid())
  salesInvoiceId String
  amount         Decimal  @db.Decimal(14, 2)
  paymentMode    String   @default("CASH")
  reference      String?
  paymentDate    DateTime @default(now())
  createdAt      DateTime @default(now())

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId])
  @@map("sales_payments")
}

model SalesInvoiceItem {
  id             String  @id @default(cuid())
  salesInvoiceId String
  productId      String
  productName    String
  quantity       Decimal @db.Decimal(14, 2)
  unitPrice      Decimal @db.Decimal(14, 2)
  gstRate        Decimal @db.Decimal(5, 2)
  taxAmount      Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([salesInvoiceId])
  @@map("sales_invoice_items")
}

model SalesReturn {
  id             String   @id @default(cuid())
  businessId     String
  salesInvoiceId String
  customerId     String
  returnNumber   String
  returnDate     DateTime @default(now())
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id])
  items        SalesReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([salesInvoiceId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(cuid())
  salesReturnId String
  productId     String
  productName   String
  quantity      Decimal @db.Decimal(14, 2)
  unitPrice     Decimal @db.Decimal(14, 2)
  gstRate       Decimal @db.Decimal(5, 2)
  taxAmount     Decimal @db.Decimal(14, 2)
  lineTotal     Decimal @db.Decimal(14, 2)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([salesReturnId])
  @@map("sales_return_items")
}

model PurchaseBill {
  id            String        @id @default(cuid())
  businessId    String
  branchId      String?
  supplierId    String
  billNumber    String
  billDate      DateTime      @default(now())
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id])
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  items    PurchaseBillItem[]
  payments PurchasePayment[]
  returns  PurchaseReturn[]

  @@unique([businessId, billNumber])
  @@index([businessId])
  @@index([branchId])
  @@map("purchase_bills")
}

model PurchasePayment {
  id             String   @id @default(cuid())
  purchaseBillId String
  amount         Decimal  @db.Decimal(14, 2)
  paymentMode    String   @default("CASH")
  reference      String?
  paymentDate    DateTime @default(now())
  createdAt      DateTime @default(now())

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)

  @@index([purchaseBillId])
  @@map("purchase_payments")
}

model PurchaseBillItem {
  id             String  @id @default(cuid())
  purchaseBillId String
  productId      String
  productName    String
  quantity       Decimal @db.Decimal(14, 2)
  unitPrice      Decimal @db.Decimal(14, 2)
  gstRate        Decimal @db.Decimal(5, 2)
  taxAmount      Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([purchaseBillId])
  @@map("purchase_bill_items")
}

model PurchaseReturn {
  id             String   @id @default(cuid())
  businessId     String
  purchaseBillId String
  supplierId     String
  returnNumber   String
  returnDate     DateTime @default(now())
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseBill PurchaseBill         @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  items        PurchaseReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([purchaseBillId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  productId        String
  productName      String
  quantity         Decimal @db.Decimal(14, 2)
  unitPrice        Decimal @db.Decimal(14, 2)
  gstRate          Decimal @db.Decimal(5, 2)
  taxAmount        Decimal @db.Decimal(14, 2)
  lineTotal        Decimal @db.Decimal(14, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String?
  category    String
  amount      Decimal  @db.Decimal(14, 2)
  paymentMode String   @default("CASH")
  reference   String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@index([businessId])
  @@index([branchId])
  @@map("expenses")
}
