// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  MANAGER
  ACCOUNTANT
  CASHIER
  STAFF
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

enum EwayBillStatus {
  GENERATED
  CANCELLED
}

enum StockSourceType {
  PURCHASE
  PURCHASE_RETURN
  SALES
  SALES_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum JournalSourceType {
  MANUAL
  SALES_INVOICE
  SALES_PAYMENT
  SALES_RETURN
  PURCHASE_BILL
  PURCHASE_PAYMENT
  PURCHASE_RETURN
  EXPENSE
}

// A platform-level user. Can belong to multiple businesses via Membership.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

// A tenant. All business data is scoped to a businessId.
model Business {
  id                 String    @id @default(cuid())
  name               String
  gstin              String?
  pan                String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  logoUrl            String?
  financialYearStart DateTime?
  invoicePrefix      String    @default("INV")
  currency           String    @default("INR")
  status             BusinessStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships     Membership[]
  customers       Customer[]
  suppliers       Supplier[]
  products        Product[]
  salesInvoices   SalesInvoice[]
  purchaseBills   PurchaseBill[]
  expenses        Expense[]
  salesReturns    SalesReturn[]
  purchaseReturns PurchaseReturn[]
  branches        Branch[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  auditLogs       AuditLog[]
  ewayBills       EwayBill[]
  godowns         Godown[]
  batches         Batch[]
  productStocks   ProductStock[]
  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]
  quotations      Quotation[]

  @@map("businesses")
}

model Account {
  id             String      @id @default(cuid())
  businessId     String
  code           String
  name           String
  type           AccountType
  isSystem       Boolean     @default(false)
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalLines JournalEntryLine[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("accounts")
}

model JournalEntry {
  id          String            @id @default(cuid())
  businessId  String
  entryNumber String
  entryDate   DateTime          @default(now())
  narration   String?
  sourceType  JournalSourceType @default(MANUAL)
  sourceId    String?
  createdAt   DateTime          @default(now())

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines    JournalEntryLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model Branch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  purchaseBills PurchaseBill[]
  expenses      Expense[]
  godowns       Godown[]
  quotations    Quotation[]

  @@index([businessId])
  @@map("branches")
}

model Godown {
  id         String   @id @default(cuid())
  businessId String
  branchId   String
  name       String
  address    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stocks         ProductStock[]
  movements      StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  salesInvoices  SalesInvoice[]
  purchaseBills  PurchaseBill[]

  @@index([businessId])
  @@index([branchId])
  @@map("godowns")
}

model Batch {
  id              String    @id @default(cuid())
  businessId      String
  productId       String
  batchNumber     String
  manufactureDate DateTime?
  expiryDate      DateTime?
  createdAt       DateTime  @default(now())

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks            ProductStock[]
  movements         StockMovement[]
  transfers         StockTransfer[]
  salesConsumptions SalesInvoiceItemBatch[]
  salesRestorations SalesReturnItemBatch[]

  @@unique([productId, batchNumber])
  @@index([businessId])
  @@map("batches")
}

model ProductStock {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  godownId   String
  batchId    String?
  quantity   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  godown   Godown   @relation(fields: [godownId], references: [id], onDelete: Cascade)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([productId, godownId, batchId])
  @@index([businessId])
  @@map("product_stocks")
}

model StockMovement {
  id         String          @id @default(cuid())
  businessId String
  productId  String
  godownId   String
  batchId    String?
  quantity   Decimal         @db.Decimal(14, 2)
  sourceType StockSourceType
  sourceId   String?
  notes      String?
  createdAt  DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  godown   Godown   @relation(fields: [godownId], references: [id], onDelete: Cascade)
  batch    Batch?   @relation(fields: [batchId], references: [id])

  @@index([businessId])
  @@index([productId, godownId])
  @@map("stock_movements")
}

model StockTransfer {
  id           String   @id @default(cuid())
  businessId   String
  productId    String
  batchId      String?
  fromGodownId String
  toGodownId   String
  quantity     Decimal  @db.Decimal(14, 2)
  transferDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch      Batch?   @relation(fields: [batchId], references: [id])
  fromGodown Godown   @relation("TransferFrom", fields: [fromGodownId], references: [id])
  toGodown   Godown   @relation("TransferTo", fields: [toGodownId], references: [id])

  @@index([businessId])
  @@map("stock_transfers")
}

// Links a User to a Business with a role — supports multi-business users.
model Membership {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("memberships")
}

model Customer {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  creditLimit    Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  salesReturns  SalesReturn[]
  quotations    Quotation[]

  @@index([businessId])
  @@map("customers")
}

model Supplier {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseBills   PurchaseBill[]
  purchaseReturns PurchaseReturn[]

  @@index([businessId])
  @@map("suppliers")
}

model Product {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  sku           String?
  barcode       String?
  category      String?
  unit          String   @default("PCS")
  hsnCode       String?
  purchasePrice Decimal  @default(0) @db.Decimal(14, 2)
  sellingPrice  Decimal  @default(0) @db.Decimal(14, 2)
  gstRate       Decimal  @default(0) @db.Decimal(5, 2)
  openingStock  Decimal  @default(0) @db.Decimal(14, 2)
  currentStock  Decimal  @default(0) @db.Decimal(14, 2)
  minStockLevel Decimal  @default(0) @db.Decimal(14, 2)
  tracksBatches Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoiceItems   SalesInvoiceItem[]
  purchaseBillItems   PurchaseBillItem[]
  salesReturnItems    SalesReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  batches             Batch[]
  stocks              ProductStock[]
  movements           StockMovement[]
  transfers           StockTransfer[]
  quotationItems      QuotationItem[]

  @@index([businessId])
  @@map("products")
}

model SalesInvoice {
  id            String        @id @default(cuid())
  businessId    String
  branchId      String?
  godownId      String?
  customerId    String
  invoiceNumber String
  invoiceDate   DateTime      @default(now())
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  paymentMode   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id])
  godown   Godown?            @relation(fields: [godownId], references: [id])
  customer Customer           @relation(fields: [customerId], references: [id])
  items      SalesInvoiceItem[]
  payments   SalesPayment[]
  returns    SalesReturn[]
  ewayBill   EwayBill?
  quotation  Quotation?

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([godownId])
  @@map("sales_invoices")
}

model SalesPayment {
  id             String   @id @default(cuid())
  salesInvoiceId String
  amount         Decimal  @db.Decimal(14, 2)
  paymentMode    String   @default("CASH")
  reference      String?
  paymentDate    DateTime @default(now())
  createdAt      DateTime @default(now())

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId])
  @@map("sales_payments")
}

model SalesInvoiceItem {
  id             String  @id @default(cuid())
  salesInvoiceId String
  productId      String
  productName    String
  quantity       Decimal @db.Decimal(14, 2)
  unitPrice      Decimal @db.Decimal(14, 2)
  gstRate        Decimal @db.Decimal(5, 2)
  taxAmount      Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  salesInvoice SalesInvoice           @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id])
  batches      SalesInvoiceItemBatch[]

  @@index([salesInvoiceId])
  @@map("sales_invoice_items")
}

model SalesInvoiceItemBatch {
  id                 String  @id @default(cuid())
  salesInvoiceItemId String
  batchId            String
  quantity            Decimal @db.Decimal(14, 2)

  salesInvoiceItem SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Cascade)
  batch            Batch            @relation(fields: [batchId], references: [id])

  @@index([salesInvoiceItemId])
  @@map("sales_invoice_item_batches")
}

model Quotation {
  id                String          @id @default(cuid())
  businessId        String
  branchId          String?
  customerId        String
  quotationNumber   String
  quotationDate     DateTime        @default(now())
  validUntil        DateTime?
  status            QuotationStatus @default(DRAFT)
  subtotal          Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal        Decimal         @default(0) @db.Decimal(14, 2)
  notes             String?
  convertedInvoiceId String?        @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  items            QuotationItem[]
  convertedInvoice SalesInvoice?    @relation(fields: [convertedInvoiceId], references: [id])

  @@unique([businessId, quotationNumber])
  @@index([businessId])
  @@index([branchId])
  @@map("quotations")
}

model QuotationItem {
  id            String  @id @default(cuid())
  quotationId   String
  productId     String
  productName   String
  quantity      Decimal @db.Decimal(14, 2)
  unitPrice     Decimal @db.Decimal(14, 2)
  gstRate       Decimal @db.Decimal(5, 2)
  taxAmount     Decimal @db.Decimal(14, 2)
  lineTotal     Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@map("quotation_items")
}

model SalesReturn {
  id             String   @id @default(cuid())
  businessId     String
  salesInvoiceId String
  customerId     String
  returnNumber   String
  returnDate     DateTime @default(now())
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id])
  items        SalesReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([salesInvoiceId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(cuid())
  salesReturnId String
  productId     String
  productName   String
  quantity      Decimal @db.Decimal(14, 2)
  unitPrice     Decimal @db.Decimal(14, 2)
  gstRate       Decimal @db.Decimal(5, 2)
  taxAmount     Decimal @db.Decimal(14, 2)
  lineTotal     Decimal @db.Decimal(14, 2)

  salesReturn SalesReturn             @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product                 @relation(fields: [productId], references: [id])
  batches     SalesReturnItemBatch[]

  @@index([salesReturnId])
  @@map("sales_return_items")
}

model SalesReturnItemBatch {
  id                String  @id @default(cuid())
  salesReturnItemId String
  batchId           String
  quantity          Decimal @db.Decimal(14, 2)

  salesReturnItem SalesReturnItem @relation(fields: [salesReturnItemId], references: [id], onDelete: Cascade)
  batch           Batch           @relation(fields: [batchId], references: [id])

  @@index([salesReturnItemId])
  @@map("sales_return_item_batches")
}

model PurchaseBill {
  id            String        @id @default(cuid())
  businessId    String
  branchId      String?
  godownId      String?
  supplierId    String
  billNumber    String
  billDate      DateTime      @default(now())
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id])
  godown   Godown?            @relation(fields: [godownId], references: [id])
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  items    PurchaseBillItem[]
  payments PurchasePayment[]
  returns  PurchaseReturn[]

  @@unique([businessId, billNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([godownId])
  @@map("purchase_bills")
}

model PurchasePayment {
  id             String   @id @default(cuid())
  purchaseBillId String
  amount         Decimal  @db.Decimal(14, 2)
  paymentMode    String   @default("CASH")
  reference      String?
  paymentDate    DateTime @default(now())
  createdAt      DateTime @default(now())

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)

  @@index([purchaseBillId])
  @@map("purchase_payments")
}

model PurchaseBillItem {
  id              String    @id @default(cuid())
  purchaseBillId  String
  productId       String
  productName     String
  quantity        Decimal   @db.Decimal(14, 2)
  unitPrice       Decimal   @db.Decimal(14, 2)
  gstRate         Decimal   @db.Decimal(5, 2)
  taxAmount       Decimal   @db.Decimal(14, 2)
  lineTotal       Decimal   @db.Decimal(14, 2)
  batchNumber     String?
  manufactureDate DateTime?
  expiryDate      DateTime?

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([purchaseBillId])
  @@map("purchase_bill_items")
}

model PurchaseReturn {
  id             String   @id @default(cuid())
  businessId     String
  purchaseBillId String
  supplierId     String
  returnNumber   String
  returnDate     DateTime @default(now())
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseBill PurchaseBill         @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  items        PurchaseReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([purchaseBillId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  productId        String
  productName      String
  quantity         Decimal @db.Decimal(14, 2)
  unitPrice        Decimal @db.Decimal(14, 2)
  gstRate          Decimal @db.Decimal(5, 2)
  taxAmount        Decimal @db.Decimal(14, 2)
  lineTotal        Decimal @db.Decimal(14, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String?
  category    String
  amount      Decimal  @db.Decimal(14, 2)
  paymentMode String   @default("CASH")
  reference   String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@index([businessId])
  @@index([branchId])
  @@map("expenses")
}

model AuditLog {
  id         String      @id @default(cuid())
  businessId String
  userId     String?
  userEmail  String?
  entityType String
  entityId   String
  action     AuditAction
  summary    String?
  changes    Json?
  createdAt  DateTime    @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@map("audit_logs")
}

model EwayBill {
  id               String         @id @default(cuid())
  businessId       String
  salesInvoiceId   String         @unique
  ewbNumber        String?
  transporterName  String?
  transporterId    String?
  vehicleNumber    String?
  transportMode    TransportMode  @default(ROAD)
  distanceKm       Int
  validUntil       DateTime
  status           EwayBillStatus @default(GENERATED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("eway_bills")
}
