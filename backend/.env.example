# Local development database (see docker-compose.yml at repo root)
DATABASE_URL="postgresql://finzo:finzo@127.0.0.1:5433/finzo?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000

# Comma-separated emails granted platform Super Admin access (auto-promoted on register/login)
SUPER_ADMIN_EMAILS="admin@finzo.com"
